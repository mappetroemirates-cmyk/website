# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/map_petro_emirates?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Cloudflare R2 (S3-compatible storage for resumes/CVs)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="map-petro-emirates-resumes"
# Public base URL for serving uploaded files (R2 public bucket URL or custom domain)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
