generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Candidate {
  id              String   @id @default(cuid())
  fullName        String
  email           String   @unique
  password        String
  phone           String?
  location        String?
  education       String?
  workExperience  String?
  skills          String?
  resumeUrl       String?
  profilePhotoUrl String?
  createdAt       DateTime @default(now())

  applications Application[]

  @@map("candidates")
}

enum AdminRole {
  SUPER_ADMIN
  STAFF

  @@map("admin_role")
}

model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      AdminRole @default(STAFF)
  createdAt DateTime  @default(now())

  @@map("admins")
}

enum JobType {
  full_time @map("full-time")
  part_time @map("part-time")
  contract

  @@map("job_type")
}

model Job {
  id                  String    @id @default(cuid())
  title               String
  companyName         String
  location            String
  jobType             JobType
  salary              String?
  description         String
  requiredSkills      String?
  qualifications      String?
  experienceRequired  String?
  applicationDeadline DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  applications Application[]

  // Set when this listing was created from a recruiter's hiring request,
  // so admin (and eventually the recruiter) can trace the two together.
  sourceHiringRequestId String?
  sourceHiringRequest   HiringRequest? @relation(fields: [sourceHiringRequestId], references: [id])

  @@map("jobs")
}

enum ApplicationStatus {
  applied
  under_review @map("under-review")
  shortlisted
  rejected
  hired

  @@map("application_status")
}

model Application {
  id          String            @id @default(cuid())
  candidateId String
  jobId       String
  status      ApplicationStatus @default(applied)
  appliedAt   DateTime          @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // A candidate may only apply once per job.
  @@unique([candidateId, jobId])
  @@map("applications")
}

enum AnnouncementType {
  job_update @map("job-update")
  event
  notice

  @@map("announcement_type")
}

model Announcement {
  id          String           @id @default(cuid())
  title       String
  content     String
  type        AnnouncementType
  publishedAt DateTime         @default(now())

  @@map("announcements")
}

// Minimal editable-text-block CMS: a handful of named keys (about_us_text,
// contact_phone, contact_email, contact_address) edited from /admin/content
// and read directly by the public site.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// Messages submitted through the public site's /contact form.
model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String
  submittedAt DateTime @default(now())
  isRead      Boolean  @default(false)

  @@map("contact_submissions")
}

// Simple contact list of employer/client companies MAP Petro Emirates places
// candidates with — not a login/account system, just an admin-side CRM.
model Client {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime @default(now())

  @@map("clients")
}

enum HiringRequestStatus {
  submitted
  under_review @map("under-review")
  in_progress  @map("in-progress")
  fulfilled
  closed

  @@map("hiring_request_status")
}

// Third user type alongside Candidate and Admin. Recruiters register/log in
// on the public site and submit HiringRequests — they never create job
// listings directly; only Admin turns a request into an actual Job.
model Recruiter {
  id                String   @id @default(cuid())
  companyName       String
  contactPersonName String
  email             String   @unique
  phone             String
  password          String
  industry          String?
  createdAt         DateTime @default(now())

  hiringRequests HiringRequest[]

  @@map("recruiters")
}

model HiringRequest {
  id                 String              @id @default(cuid())
  recruiterId        String
  department         String
  numberOfPositions  Int
  roleTitle          String
  jobType            JobType
  experienceRequired String
  preferredStartDate DateTime?
  additionalNotes    String?
  status             HiringRequestStatus @default(submitted)
  createdAt          DateTime            @default(now())

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  jobs      Job[]

  @@map("hiring_requests")
}
